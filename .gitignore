# Git 管理対象から除外するファイル・ディレクトリの定義

# OS / エディタ固有の一時ファイル
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Node.js / 依存関係・ログ
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ビルド成果物・一時ファイル
dist/
deb-dist/
release-files/
*.tsbuildinfo
*.log
*.tmp

# Debian / Ubuntu パッケージビルド時の生成物
debian/.debhelper/
debian/cockpit-speedtest/
debian/cockpit-speedtest.*
debian/debhelper-build-stamp
debian/files
debian/*.substvars
debian/*.debhelper.log
*.deb
*.buildinfo
*.changes
